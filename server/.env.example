# ================================================================
# Meiora AI – Backend Environment Configuration Template
# Duplicate this file as .env and populate with your own credentials
# ================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/meiora_ai?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini AI API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin (for CORS)
CLIENT_URL=http://localhost:5173

# NewsAPI.org Key (for Live Regional News Intelligence)
NEWS_API_KEY=your_news_api_key_here

# Email Service Credentials (Nodemailer for OTP verification)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

